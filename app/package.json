{
  "name": "dothereading",
  "version": "1.0.0",
  "description": "DoTheReading: read the paper, answer the questions",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "productName": "DoTheReading",
  "build": {
    "appId": "com.lhmartin.dothereading",
    "productName": "DoTheReading",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/pipeline",
        "to": "pipeline"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DoTheReading",
      "artifactName": "DoTheReading-Setup-${version}.${ext}"
    }
  }
}
